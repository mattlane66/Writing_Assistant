{
  "name": "writing-assistant",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "description": "Canonical Writing Assistant knowledge with a read-only repository MCP and an optional bounded OpenAI Agents SDK web-editor pipeline.",
  "scripts": {
    "dev": "concurrently --kill-others --names api,web --prefix-colors red,blue \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production node server/index.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run knowledge:verify && npm run eval:concepts && npm run eval:book-informed && npm run lint && npm run test && npm run build && npm run writing-assistant-plugin:check && npm run diagnostic:check",
    "eval:book-informed": "node evals/run-book-informed.mjs",
    "knowledge:ingest": "node scripts/ingest-knowledge.mjs",
    "knowledge:verify": "node scripts/verify-knowledge.mjs",
    "eval:concepts": "node evals/run-concepts.mjs",
    "eval:concepts:live": "node evals/run-concepts.mjs --live",
    "smoke": "node scripts/smoke.mjs",
    "diagnostic:dev": "PORT=8790 npm --prefix products/writing-diagnostic start",
    "diagnostic:stdio": "npm --prefix products/writing-diagnostic run stdio",
    "diagnostic:test": "npm --prefix products/writing-diagnostic test",
    "diagnostic:check": "npm run diagnostic:test && npm --prefix products/writing-diagnostic run check",
    "diagnostic:package": "npm --prefix products/writing-diagnostic run package",
    "mcp:start": "node server/index.mjs",
    "writing-assistant-plugin:package": "python3 scripts/package-writing-assistant-plugin.py",
    "writing-assistant-plugin:check": "WRITING_ASSISTANT_MCP_URL=https://example.com/mcp python3 scripts/package-writing-assistant-plugin.py --allow-example-url"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@openai/agents": "^0.17.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "lucide-react": "^1.37.0",
    "openai": "^7.8.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "supertest": "^7.2.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
