{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://writing-assistant.local/schemas/concept-registry-v1.json",
  "title": "Writing Assistant concept registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_version", "concepts"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "registry_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/concept"
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref", "locator", "provenance"],
      "properties": {
        "kind": {
          "enum": ["repository", "private-pdf"]
        },
        "ref": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "locator": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "provenance": {
          "enum": [
            "controlling-synthesis",
            "operational-synthesis",
            "vendored-method",
            "primary-reference",
            "secondary-corroboration"
          ]
        },
        "note": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "evalCriteria": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recognition", "execution"],
      "properties": {
        "recognition": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "execution": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      }
    },
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "category",
        "description",
        "procedure",
        "triggers",
        "anti_triggers",
        "exceptions",
        "sources",
        "eval_criteria"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "category": {
          "enum": [
            "editorial-contract",
            "craft",
            "syntax",
            "source-discipline",
            "coherence",
            "argument-reasoning"
          ]
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "procedure": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "triggers": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "anti_triggers": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "exceptions": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "eval_criteria": {
          "$ref": "#/$defs/evalCriteria"
        }
      }
    }
  }
}
